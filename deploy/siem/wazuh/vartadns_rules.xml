<!--
  VartaDNS rules for Wazuh 4.x (custom rule IDs 100500-100519).
  Copy to /var/ossec/etc/rules/ on the Wazuh manager and restart it.
  NOTE: not tested on a live manager; verify with wazuh-logtest.
-->
<group name="vartadns,dns,">

  <rule id="100500" level="0">
    <decoded_as>vartadns</decoded_as>
    <description>VartaDNS event</description>
  </rule>

  <rule id="100501" level="10">
    <if_sid>100500</if_sid>
    <field name="status">^blocked$</field>
    <field name="kind">^malware$</field>
    <description>VartaDNS: malware domain $(name) blocked for $(client) $(device)</description>
    <group>malware,</group>
  </rule>

  <rule id="100502" level="8">
    <if_sid>100500</if_sid>
    <field name="status">^blocked$</field>
    <field name="kind">^phishing$</field>
    <description>VartaDNS: phishing domain $(name) blocked for $(client) $(device)</description>
    <group>phishing,</group>
  </rule>

  <rule id="100503" level="3">
    <if_sid>100500</if_sid>
    <field name="status">^blocked$</field>
    <description>VartaDNS: $(name) blocked ($(kind)) for $(client)</description>
  </rule>

  <!-- Many different malware domains from one client: likely infected. -->
  <rule id="100504" level="12" frequency="5" timeframe="3600">
    <if_matched_sid>100501</if_matched_sid>
    <same_field>client</same_field>
    <different_field>name</different_field>
    <description>VartaDNS: $(client) queried 5+ different malware domains in an hour (possible infection)</description>
    <group>malware,</group>
  </rule>

  <rule id="100510" level="0">
    <if_sid>100500</if_sid>
    <field name="action">\.+</field>
    <description>VartaDNS panel audit: $(user) $(action) ($(status))</description>
  </rule>

  <rule id="100511" level="5">
    <if_sid>100510</if_sid>
    <field name="action">^login$</field>
    <field name="status">^401$</field>
    <description>VartaDNS panel: failed login for $(user) from $(ip)</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100512" level="10" frequency="5" timeframe="600">
    <if_matched_sid>100511</if_matched_sid>
    <same_field>ip</same_field>
    <description>VartaDNS panel: 5 failed logins from $(ip) in 10 minutes</description>
    <group>authentication_failures,</group>
  </rule>

</group>
